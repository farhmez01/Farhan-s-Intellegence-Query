   prefin1 AS (
  SELECT
    css.date_timestamp,
    css.store_code,
    css.sku,
    css.description,
    COALESCE(so.so_qty, 0) AS so_qty,
    COALESCE(do.daily_out, 0) AS daily_out,
    COALESCE(ib.inbound_qty, 0) AS inbound_qty,
    COALESCE(ib.inbound_qty,0) + COALESCE(so.so_qty,0) - COALESCE(do.daily_out,0) AS net_flow
  FROM calendar_sku_store_combination css
  LEFT JOIN so_map so
    ON css.date_timestamp = so.so_date
   AND css.store_code = SUBSTRING(so.site,1,5)
   AND css.sku = so.sku
  LEFT JOIN daily_orders do
    ON css.date_timestamp = do.order_date
   AND css.store_code = do.store_code
   AND css.sku = do.sku
  LEFT JOIN ib_qty_date ib
    ON css.date_timestamp = ib.ib_date
   AND css.store_code = SUBSTRING(ib.site,1,5)
   AND css.sku = ib.sku
),
-- Step 1: compute cumulative net flow
cum AS (
  SELECT
    *,
    SUM(net_flow) OVER (
      PARTITION BY store_code, sku
      ORDER BY date_timestamp
      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ) AS cum_flow
  FROM prefin1
),

-- Step 2: mark reset when inbound arrives after cum_flow was ≤ 0
resets AS (
  SELECT
    *,
    CASE
      WHEN inbound_qty > 0
           AND LAG(cum_flow) OVER (PARTITION BY store_code, sku ORDER BY date_timestamp) <= 0
      THEN 1 ELSE 0 END AS reset_flag
  FROM cum
),

-- Step 3: group by reset_flag
reset_groups AS (
  SELECT
    *,
    SUM(reset_flag) OVER (
      PARTITION BY store_code, sku
      ORDER BY date_timestamp
      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ) AS reset_group
  FROM resets
),

-- Step 4: compute running stock within reset groups
prefin2 AS (
  SELECT
    date_timestamp,
    store_code,
    sku,
    description,
    so_qty,
    daily_out,
    inbound_qty,
    net_flow,
    reset_flag,
    GREATEST(
      SUM(net_flow) OVER (
        PARTITION BY store_code, sku, reset_group
        ORDER BY date_timestamp
        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
      ),
      0
    ) AS current_stock
  FROM reset_groups
)

SELECT 
p2.date_timestamp, 
case 
   when iqd.site = '83502 AlloFresh Daan Mogot' then 'DMT' 
   when iqd.site = '83503 AlloFresh Gading Serpong' then 'GS' 
   when iqd.site = '83504 AlloFresh Lebak Bulus' then 'LBB' 
   when iqd.site = '83505 AlloFresh Pluit' then 'PLT' 
   when iqd.site = '83510 AlloFresh Cawang' then 'CWG' 
   when iqd.site = '83512 Allofresh Cempaka Putih Galur' then 'GLR' 
   when iqd.site = '83514 Allofresh Cipondoh' then 'CPD' 
   when iqd.site = '83516 Allofresh Kembangan' then 'KMB' 
   when iqd.site = '83559 AF ISW Central Park Tj Duren' then 'TJD' 
   when iqd.site = '83617 AF ISW Bintaro' then 'BTR' 
   end as site, 
p2.sku, 
p2.description, 
p2.daily_out, 
p2.current_stock
FROM prefin2 p2
left join (select distinct site from `data_pool_real_time.ims_prieds_inventories`) iqd on p2.store_code = substring(iqd.site,1,5)
where 
date_timestamp = current_date()-1
ORDER BY 
store_code, 
sku,
date_timestamp
