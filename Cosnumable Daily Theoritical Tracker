    WITH calendar AS (
      SELECT
        DATE('2025-08-01') + INTERVAL x DAY AS date_timestamp
      FROM
        UNNEST(GENERATE_ARRAY(0, 90)) x
    ),
    
    stores AS (
      SELECT
        store_code
      FROM
        UNNEST(
          [
      '83502','83503','83504','83505',
      '83510','83559','83617','83514','83512','83516'
    ]
        ) AS store_code
    ),
    
    sku as (
        SELECT
  distinct logs.sku AS sku,
  case when oms.container_name is not null then oms.container_name
  else mt.description
  end as description
FROM
  `data_pool_real_time.ims_prieds_inventory_logs` logs
left join `data_pool.oms_master_container` oms on logs.sku = oms.sku
left join `data_pool_real_time.ims_prieds_master_products` mt on mt.sku = logs.sku
WHERE
  SUBSTRING(logs.sku, 1, 2) = '75'),
            
    calendar_sku_store_combination AS (
      SELECT
        date(c.date_timestamp) date_timestamp,
        sc.store_code,
        sk.sku,
        sk.description
      FROM
        calendar c
        CROSS JOIN stores sc
        cross join sku sk),

      so_qty_date AS (
        SELECT
          DATE(TIMESTAMP_MILLIS(il.created_at)) AS so_date,
          il.site AS site,
          sk.sku AS sku,
          CASE
            WHEN il.action IN ('stockopname.update', 'beginning_balance.create','stocktransferwithsloc.create') THEN il.new_qty
            ELSE NULL
          END AS raw_so_qty
        FROM
          `data_pool_real_time.ims_prieds_inventory_logs` il
        left join
          sku sk on il.sku = sk.sku
        WHERE
            il.action IN (
            'stockopname.update',
            'beginning_balance.create',
            'stocktransferwithsloc.create'
          )
          AND il.zone IN ('FFL', 'Packaging', 'PACKAGING')
          and il.adjustment_qty > 0),
      
      latest_so AS (
        SELECT
          site,
          sku,
          MAX(so_date) AS latest_so_date
        FROM
          so_qty_date
      GROUP BY
          site,
          sku
      ),
      
      ib_qty_date AS (
  SELECT
    DATE(TIMESTAMP_MILLIS(il.created_at)) AS ib_date,
    il.site AS site,
    il.sku AS sku,
    ls.latest_so_date,
    sum(CASE
      WHEN il.action = 'putaway.update' THEN il.new_qty
      ELSE 0 end)
    AS inbound_qty
  FROM
    `data_pool_real_time.ims_prieds_inventory_logs` il
  LEFT JOIN sku sk
    ON il.sku = sk.sku
  left join latest_so ls on ls.sku = il.sku and ls.site = il.site
  WHERE
    il.action = 'putaway.update'
    AND il.zone IN ('FFL', 'Packaging', 'PACKAGING')
    and DATE(TIMESTAMP_MILLIS(il.created_at)) >= ls.latest_so_date
    and il.adjustment_qty > 0
  group by 1,2,3,4
),
    
    daily_orders AS (
      SELECT
        order_date,
        store_code,
        sku,
        description,
        SUM(daily_out) AS daily_out
      FROM
        (
          SELECT
            DATE(TIMESTAMP_MILLIS(f.paid_at)) AS order_date,
            s.store_code,
            o.container_name AS description,
            o.sku,
            SUM(o.sum) AS daily_out
          FROM
            `dbt_models.fct_transaction_allofresh` f
            LEFT JOIN (
              SELECT
                oc.container_barcode,
                sk.sku,
                oc.order_id,
                m.container_name,
                SUM(oc.container_sequence) AS sum
              FROM
                `data_pool.oms_order_container` oc
                LEFT JOIN `data_pool.oms_master_container` m ON oc.container_barcode = m.container_barcode
                left join sku sk on m.sku = sk.sku
              GROUP BY
                oc.container_barcode,
                sk.sku,
                oc.order_id,
                m.container_name
            ) o ON f.order_id = o.order_id
            left join stores s on f.store_code = s.store_code
            left join latest_so ls on f.store_code = substring(ls.site,1,5) and o.sku = ls.sku
          WHERE
            f.paid_at IS NOT NULL
            AND o.container_barcode IS NOT NULL
            AND o.container_barcode <> ''
            AND o.container_name IS NOT NULL
            and DATE(TIMESTAMP_MILLIS(f.paid_at)) >= ls.latest_so_date
          GROUP BY
            order_date,
            store_code,
            o.sku,
            description
        )
      GROUP BY
        order_date,
        store_code,
        sku,
        description
    )
    ,
    
    so_mapping AS (
      select c.date_timestamp,c.store_code, c.sku, c.description, lo.latest_so_date, COALESCE(sqd.raw_so_qty,0) as so_qty from calendar_sku_store_combination c 
      left join latest_so lo on c.store_code = substring(lo.site,1,5) and c.sku = lo.sku 
      join so_qty_date sqd on  c.store_code = substring(sqd.site,1,5) and c.sku = sqd.sku and lo.latest_so_date = sqd.so_date
      where c.date_timestamp >= sqd.so_date
    )
    ,
    
    so_map as (
    select ls.latest_so_date as so_date, ls.site, ls.sku, sqd.raw_so_qty as so_qty from latest_so ls left join so_qty_date sqd on sqd.so_date = ls.latest_so_date and sqd.sku =ls.sku and sqd.site = ls.site),
    
